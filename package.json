{
  "name": "chem-3d-dcs",
  "version": "1.0.0",
  "private": true,
  "description": "CHEM-3D DCS – a 3D distributed control system and operator training simulator for a chemical process unit",
  "type": "module",
  "workspaces": [
    "server",
    "client"
