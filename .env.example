# Copy to .env and adjust. All variables are optional except where noted.

# HTTP listen address
PORT=8080
HOST=0.0.0.0

# Secret used to sign session tokens (required for docker compose; recommended everywhere)
DCS_SECRET=replace-with-a-long-random-string

# User accounts (JSON). When unset, demo accounts operator/engineer/instructor/viewer are used
# with the password equal to the username.
# DCS_USERS=[{"username":"op1","password":"s3cret","role":"operator","displayName":"Shift A Operator"}]

# Where snapshots are persisted
DATA_DIR=./data

# Seconds of simulated time used to settle the plant at start-up
PRERUN_SECONDS=14400

# Historian retention (hours of 1-second samples)
HISTORIAN_HOURS=4

# WebSocket broadcast period in ms
BROADCAST_MS=500

# Fixed seed for reproducible measurement noise
# SIM_SEED=12345
